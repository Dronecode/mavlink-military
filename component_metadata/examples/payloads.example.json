            {
              "service": "payload-operation",
              "description": "Operation exchange served by the payload manager, for this function's profile operations. targetComponentId is omitted, so requests go to the publishing manager's component."
            }
          ],
          "capabilityProfiles": [
            {
              "profileId": "com.example.linear-actuator",
              "profileVersion": 1,
              "definitionUri": "https://example.org/mavlink-m/profiles/com.example.linear-actuator/1/profile.json",
              "sha256": "dba2f47be49723b0ede00e80a21dff16efe64def55bdb276a87948ca783d7dc3",
              "instanceKey": "dual-actuator-a"
            }
          ]
        },
        {
          "functionId": 2,
          "descriptorRevision": 1,
          "label": "Actuator B",
          "description": "Second linear actuator of the unit.",
          "serviceBindings": [
            {
              "service": "payload-operation",
              "description": "Operation exchange served by the payload manager, for this function's profile operations. targetComponentId is omitted, so requests go to the publishing manager's component."
            }
          ],
          "capabilityProfiles": [
            {
              "profileId": "com.example.linear-actuator",
              "profileVersion": 1,
              "definitionUri": "https://example.org/mavlink-m/profiles/com.example.linear-actuator/1/profile.json",
              "sha256": "dba2f47be49723b0ede00e80a21dff16efe64def55bdb276a87948ca783d7dc3",
              "instanceKey": "dual-actuator-b"
            }
          ]
        }
      ]
    }
  ],
  "constraints": [
    {
      "constraintKey": "dual-actuator-exclusive-motion",
      "description": "The two actuators of the dual actuator unit share one drive and must not move at the same time.",
      "kind": "mutually-exclusive-actions",
      "members": [
        {
          "instanceKey": "dual-actuator-a",
          "actionKey": "com.example.linear-actuator.move-to-position"
